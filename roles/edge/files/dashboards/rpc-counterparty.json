   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(traefik_router_requests_total{router=\"counterparty@file\", code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(traefik_router_requests_total{router=\"counterparty@file\"}[5m])), 1e-9)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
