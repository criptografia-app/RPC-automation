{
 "uid": "rpc-hosts",
 "title": "RPC hosts",
 "description": "CPU, memory, disk and network for every server.",
 "tags": [
  "rpc-automation"
 ],
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "CPU busy",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg by (host) (rate(node_cpu_seconds_total{host=~\"$host\", mode=\"idle\"}[5m]))",
     "legendFormat": "{{host}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Load (1m) per core",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_load1{host=~\"$host\"} / on (host) count by (host) (node_cpu_seconds_total{host=~\"$host\", mode=\"idle\"})",
     "legendFormat": "{{host}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Memory used",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"}",
     "legendFormat": "{{host}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Disk used",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_filesystem_avail_bytes{host=~\"$host\", fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{host=~\"$host\", fstype!~\"tmpfs|overlay|squashfs\"}",
     "legendFormat": "{{host}} {{mountpoint}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Disk free",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{host=~\"$host\", fstype!~\"tmpfs|overlay|squashfs\"}",
     "legendFormat": "{{host}} {{mountpoint}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Days until disk full (24h trend)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(node_filesystem_avail_bytes{host=~\"$host\", fstype!~\"tmpfs|overlay|squashfs\"} / clamp_min(-deriv(node_filesystem_avail_bytes{host=~\"$host\", fstype!~\"tmpfs|overlay|squashfs\"}[24h]), 1)) / 86400",
     "legendFormat": "{{host}} {{mountpoint}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Free space divided by the shrink rate over the last day. Chains only grow."
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Disk I/O",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host) (rate(node_disk_read_bytes_total{host=~\"$host\"}[5m]))",
     "legendFormat": "read {{host}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (host) (rate(node_disk_written_bytes_total{host=~\"$host\"}[5m]))",
     "legendFormat": "write {{host}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Network",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host) (rate(node_network_receive_bytes_total{host=~\"$host\", device!~\"lo|ve-.*|veth.*\"}[5m]))",
     "legendFormat": "in {{host}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (host) (rate(node_network_transmit_bytes_total{host=~\"$host\", device!~\"lo|ve-.*|veth.*\"}[5m]))",
     "legendFormat": "out {{host}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
 ],
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Server",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(node_uname_info, host)",
     "refId": "host"
    },
    "definition": "label_values(node_uname_info, host)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "links": [
  {
   "title": "RPC dashboards",
   "type": "dashboards",
   "tags": [
    "rpc-automation"
   ],
   "asDropdown": true,
   "includeVars": true,
   "keepTime": true
  }
 ]
}
