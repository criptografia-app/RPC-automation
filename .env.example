# RPC-automation: everything you set lives in this file.
#   ./deploy.sh init   copies this to .env and fills in random passwords and API keys
#   edit .env          set your servers, SSH access and domain
#   ./deploy.sh        deploys
# Values in your shell environment override this file.

# ── Servers ────────────────────────────────────────────────────────────────
# Fresh Ubuntu 24.04 (or Debian 12) servers. Each node runs every chain in CHAINS.
# Comma-separated public IPs or hostnames. Add more nodes for redundancy;
# the gateway load-balances across them.
NODE_HOSTS=203.0.113.10

# Optional: the nodes' private/VPN IPs, in the same order as NODE_HOSTS.
# When the gateway is a separate server, node RPC traffic goes over these.
# Strongly recommended for multi-server setups; without them, gateway-to-node
# traffic goes over the public IPs (firewalled to the gateway only, but not encrypted).
NODE_PRIVATE_IPS=

# The public gateway (TLS, API keys, monitoring). Leave empty to run it on
# the first node: a single-server setup.
EDGE_HOST=
EDGE_PRIVATE_IP=

# ── SSH ────────────────────────────────────────────────────────────────────
SSH_USER=root
SSH_PORT=22
# A key is recommended. Leave SSH_KEY empty to use your SSH agent.
SSH_KEY=~/.ssh/id_ed25519
# Only if you can't use a key (needs sshpass installed locally).
SSH_PASSWORD=
# Only if SSH_USER isn't root and sudo asks for a password.
SUDO_PASSWORD=

# ── Chains ─────────────────────────────────────────────────────────────────
# Any of: bitcoin, litecoin, dogecoin, counterparty
# counterparty needs bitcoin and forces a full (unpruned) Bitcoin node.
CHAINS=bitcoin

# Disk budget per chain in MB for block storage. 0 = full node (archive of all blocks).
# Pruned nodes serve current state and new blocks, not old blocks.
PRUNE_MB=5120

# Credentials between the gateway and the nodes. Clients never see these.
NODE_RPC_USER=rpc
NODE_RPC_PASSWORD=change-me

# ── Public endpoint ────────────────────────────────────────────────────────
# Point an A record for this name at the gateway's public IP before deploying.
RPC_DOMAIN=rpc.example.com
# Let's Encrypt account email.
ACME_EMAIL=you@example.com
# acme = real certificate from Let's Encrypt (needs RPC_DOMAIN + ports 80/443 open)
# selfsigned = Traefik's built-in certificate, for testing or private networks
TLS_MODE=acme
# Optional: Cloudflare token (Zone.DNS edit) to get certificates via DNS instead of port 80.
CLOUDFLARE_DNS_API_TOKEN=

# Comma-separated API keys. Clients call https://RPC_DOMAIN/<chain>/<API_KEY>
# Letters, digits, - and _ only, at least 24 characters.
API_KEYS=change-me

# ── Monitoring ─────────────────────────────────────────────────────────────
# Grafana at https://RPC_DOMAIN/grafana/ (user: admin)
GRAFANA_ADMIN_PASSWORD=change-me

# ── Host ───────────────────────────────────────────────────────────────────
# Firewall (ufw): deny incoming by default, then open SSH, P2P, 80/443, and
# node RPC to the gateway only.
FIREWALL=true
# Prefer IPv4 for downloads and image pulls (helps on hosts with broken IPv6).
FORCE_IPV4=false
